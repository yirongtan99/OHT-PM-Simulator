.p-checkbox__item label::before {
  border: 2px solid #333333;
  border-radius: 4px;
  content: "";
  height: 24px;
  left: -36px;
  position: absolute;
  top: -2px;
  transition: all 0.3s ease;
  width: 24px;
}
.p-checkbox__item label::after {
  border-left: 2px solid #ffffff;
  border-bottom: 2px solid #ffffff;
  content: "";
  height: 6px;
  left: -25px;
  opacity: 0;
  position: absolute;
  top: 8px;
  transform: rotate(-45deg);
  transform-origin: bottom left;
  transition: all 0.3s ease;
  width: 10px;
  z-index: 2;
}
